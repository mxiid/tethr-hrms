{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": false,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["modules/*"],
      "~/*": ["*"],
      "@/components/*": ["finance-ui/components/*"],
      "@/lib/*": ["finance-ui/lib/*"]
    },
    "composite": false
  },
  "include": ["src", "vite.config.ts"]
}
