{
  "name": "@hrms/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background job processor. Wraps the queue library behind a transport-agnostic abstraction (architecture.md §4).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@hrms/shared": "*",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0"
  }
}
