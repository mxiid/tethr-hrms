{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "./src",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["modules/*"],
      "~/*": ["*"]
    },
    "composite": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
