{
  "name": "@hrms/api",
  "version": "0.0.0",
  "private": true,
  "description": "Modular-monolith HRMS backend (NestJS + TypeORM + code-first GraphQL). core/ platform + modules/ HR domain.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "test": "jest",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/core/database/data-source.ts",
    "migration:run:fake": "typeorm-ts-node-commonjs migration:run -d src/core/database/data-source.ts --fake",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/core/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/core/database/data-source.ts",
    "seed:demo": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-demo.ts",
    "mark:tethr-workspace": "node -r ts-node/register -r tsconfig-paths/register scripts/mark-tethr-workspace.ts",
    "sync:role-permissions": "node -r ts-node/register -r tsconfig-paths/register scripts/sync-system-role-permissions.ts",
    "seed:org-chart": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-org-chart.ts",
    "backfill:hiring-statuses": "node -r ts-node/register -r tsconfig-paths/register scripts/backfill-hiring-statuses.ts",
    "prune:empty-assignments": "node -r ts-node/register -r tsconfig-paths/register scripts/prune-empty-assignments.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@hrms/shared": "*",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "graphql": "^16.9.0",
    "number-to-words": "^1.2.4",
    "pg": "^8.12.0",
    "puppeteer": "^25.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/number-to-words": "^1.2.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0"
  }
}
