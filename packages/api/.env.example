# Copy to .env (scripts/setup-dev.sh does this for you). Shows the SHAPE, never real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL — hosted on Supabase (Project Settings -> Database -> Connection
# string -> use the "Session pooler" host/port for a normal app connection):
DATABASE_HOST=aws-0-<region>.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_USER=postgres.<project-ref>
DATABASE_PASSWORD=<the DB password you set when creating the project>
DATABASE_NAME=postgres
DATABASE_SSL=true
# Local Postgres shape instead (e.g. `docker compose` of your own):
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=hrms
# DATABASE_PASSWORD=hrms
# DATABASE_NAME=hrms
# DATABASE_SSL=false
# LOCAL DEV ONLY: auto-creates tables from entities so the app runs without a
# migration. NEVER set true in shared/staging/prod — use migrations there.
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Redis — the API enqueues background jobs (CV parsing) and rejects `add`
# quickly when Redis is unreachable; packages/worker consumes the jobs.
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth — must be at least 32 chars (validated at startup). This is a DEV
# placeholder; generate a strong, unique value per environment and never commit it.
JWT_SECRET=dev-only-secret-change-me-please-0123456789
JWT_EXPIRES_IN=3600

# GraphQL
GRAPHQL_PLAYGROUND=true
# Introspection defaults to on in development and off in production; set true
# to opt in explicitly.
GRAPHQL_INTROSPECTION=true

# Browser origins allowed to call the API (comma-separated). Unset keeps the
# Vite dev origins in development; production refuses to boot without it.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Auth boundary throttles (sliding ten-minute windows). The IP admission limit
# runs before the per-email limit so one source cannot mint unlimited keys.
AUTH_LOGIN_LIMIT_PER_10_MIN=10
AUTH_LOGIN_IP_LIMIT_PER_10_MIN=30
AUTH_SIGNUP_LIMIT_PER_10_MIN=5

# Public form links (candidate application forms) — days a link stays valid.
FORM_LINK_TTL_DAYS=30

# Object storage. 'local' writes to ./.local-storage and mints signed links to
# the API's own /storage/local routes — development only (refused in prod).
# For 'supabase', set the project URL, the SERVICE ROLE key (server-only — it
# bypasses RLS and must never reach the browser) and create a private bucket.
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hrms-documents
STORAGE_SIGNED_URL_TTL_SECONDS=900
# Absolute base the browser can reach this API on (local driver mints links).
# PUBLIC_API_URL=http://localhost:3000
